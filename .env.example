# Public (EXPO_PUBLIC_*) values only — these are bundled into the client. Never put secrets here.
EXPO_PUBLIC_MUSLIMOON_BASE_URL=https://masajid.muslimoon.app
EXPO_PUBLIC_AHC_ORG_ID=e8a7eda8-3c55-4a9c-9b8f-9c9d37687534
# Legacy name, still honoured if EXPO_PUBLIC_AHC_ORG_ID is unset:
# EXPO_PUBLIC_MUSLIMOON_ORG_ID=e8a7eda8-3c55-4a9c-9b8f-9c9d37687534

# Firebase (src/config/firebase.ts) — these aren't secrets (Firebase's own
# docs say the web config is safe to ship client-side); access control is
# firestore.rules + what each Cloud Function does, not these ids. Get the
# real values from Firebase console -> Project settings -> your web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
